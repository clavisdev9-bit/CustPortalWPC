PORT=7181
DATABASE_URL=postgres://postgres:postgres@localhost:5432/custportalwpc
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
ENCRYPTION_KEY=replace-with-64-hex-chars-32-bytes
CORS_ORIGIN=http://localhost:7180
APP_BASE_URL=http://localhost:7180
# Only needed when something between the browser and this process rewrites the Host header before
# Express sees it (e.g. Vite's dev proxy with changeOrigin: true fronting a public IP/domain).
# Leave unset for a plain localhost setup or a production reverse proxy that preserves Host --
# without it, generated webhook URLs (Docs/ops/odoo_connection.md section 5) fall back to
# req.protocol + req.get('host'), which is wrong in the proxied case (see resolution.md BUG-23).
PUBLIC_API_BASE_URL=

# Leave SMTP_HOST unset for local dev -- emails print to the server log instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@custportal.local

# Passwordless email-OTP login (Docs/CR/customer_portal_passwordless_otp_login.md). Defaults
# below match that CR's recommended values -- all are open for business confirmation.
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_REQUEST_WINDOW_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=30

# Leave unset to disable Google SSO (POST /auth/sso/google/start returns 503 sso_not_configured).
# GOOGLE_REDIRECT_URI must exactly match an "Authorized redirect URI" on the OAuth client in
# Google Cloud Console -- typically {API_BASE_URL}/api/v1/auth/sso/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:7181/api/v1/auth/sso/google/callback
# Optional: restrict SSO to one Google Workspace domain (e.g. clavis.co.id). Leave unset to
# allow SSO from any Google account whose email matches an existing active portal_user.
GOOGLE_WORKSPACE_HD=

# AI Assistant (Docs/CR/customer_portal_ai_assistant.md). Leave ASSISTANT_ENABLED unset
# for mematikan fitur -- endpoint /assistant/* balas 503 assistant_not_configured.
#
# PENTING sejak Fase 1: semua nilai di bawah adalah lapis TERAKHIR presedensi (section 6.2).
# Baris di tabel assistant_settings -- per Odoo connection, lalu global -- MENIMPA nilai di sini,
# termasuk ASSISTANT_ENABLED. Jadi kalau sudah ada baris assistant_settings dengan enabled=true,
# menyetel ASSISTANT_ENABLED=false TIDAK mematikan asisten; matikan lewat admin UI
# (PUT /admin/assistant/settings) atau hapus barisnya.
ASSISTANT_ENABLED=false
# 'ollama' (self-host, produksi) | 'gemini' (free tier, POC dengan data sintetis SAJA --
# prompt free tier boleh dipakai melatih model provider) | 'claude' (Anthropic Messages API)
ASSISTANT_PROVIDER=ollama
ASSISTANT_BASE_URL=http://localhost:11434
# ASSISTANT_API_KEY: required for gemini and claude, unused for ollama.
ASSISTANT_API_KEY=
# ollama: keluarga qwen3 (mis. qwen3:4b/qwen3:8b) -- pastikan sudah di-`ollama pull` dulu, cek
# tag yang benar-benar tersedia lewat `ollama list` / `curl $ASSISTANT_BASE_URL/api/tags` sebelum
# mengisi ini (BUG-27, resolution.md -- tag yang belum di-pull membuat asisten gagal diam-diam
# di percobaan chat pertama, bukan saat startup). gemini: gemini-flash-latest | claude: claude-haiku-4-5
ASSISTANT_MODEL=qwen3:8b
# BUG-27: 30000 HANYA aman untuk provider cepat (gemini/claude, respons hitungan detik). Provider
# default di atas ('ollama', self-host, CPU-bound tanpa GPU) bisa makan puluhan detik per balasan
# -- pakai timeout yang jauh lebih longgar (180000 terverifikasi cukup untuk qwen3:4b lokal) kalau
# ASSISTANT_PROVIDER=ollama, turunkan lagi hanya kalau benar-benar pindah ke gemini/claude.
ASSISTANT_TIMEOUT_MS=180000
ASSISTANT_EMBEDDING_MODEL=
# Knob di bawah punya padanan kolom di assistant_settings. Nilainya WAJIB ada di salah satu
# lapis: tepat setelah migrasi 0010 belum ada satu pun baris assistant_settings, jadi env ini
# yang menopang fitur. assistantConfigService menolak mengarang nilai sendiri (503, bukan default
# diam-diam), supaya konfigurasi yang hilang terlihat sebagai kesalahan konfigurasi.
ASSISTANT_TEMPERATURE=0.2
ASSISTANT_MAX_OUTPUT_TOKENS=1024
ASSISTANT_MAX_TOOL_ITERATIONS=5
# Jumlah giliran user+assistant terakhir yang diputar ulang ke model tiap pesan.
ASSISTANT_HISTORY_WINDOW=10
# Rate limit per user (section 10.4). Portal belum punya rate limiting umum (system.md §17).
ASSISTANT_DAILY_MESSAGE_QUOTA=100
ASSISTANT_BURST_PER_MINUTE=6
ASSISTANT_DEFAULT_LOCALE=id
